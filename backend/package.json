{
	"name": "ars-futuro-backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"start": "tsx src/server.ts",
		"typecheck": "tsc --noEmit",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:seed": "prisma db seed",
		"test": "vitest run",
		"check": "biome check src tests prisma",
		"check:fix": "biome check --write src tests prisma"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "7.10.0",
		"bcryptjs": "3.0.3",
		"cors": "^2.8.6",
		"dotenv": "18.0.0",
		"express": "5.2.1",
		"helmet": "^8.3.0",
		"jsonwebtoken": "9.0.3",
		"pg": "^8.23.0",
		"swagger-jsdoc": "6.3.0",
		"swagger-ui-express": "5.0.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.6",
		"@types/jsonwebtoken": "9.0.10",
		"@types/pg": "^8.23.1",
		"@types/swagger-jsdoc": "6.0.4",
		"@types/swagger-ui-express": "4.1.8",
		"prisma": "7.10.0",
		"supertest": "7.2.2",
		"tsx": "4.23.13",
		"typescript": "7.0.2",
		"vitest": "5.0.1"
	}
}
